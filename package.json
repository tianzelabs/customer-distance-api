{
  "name": "customer-distance-api",
  "version": "1.0.0",
  "description": "Ez a házi feladat ugyanazon PostgreSQL REST API feladaton keresztül hasonlítja össze a Superpowers és a BMAD-METHOD módszertant.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "DOTENV_CONFIG_QUIET=true node-pg-migrate up",
    "migrate:down": "DOTENV_CONFIG_QUIET=true node-pg-migrate down",
    "migrate:test:up": "DOTENV_CONFIG_QUIET=true node-pg-migrate up --database-url-var TEST_DATABASE_URL",
    "seed": "tsx src/seed.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "8.20.0",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "node-pg-migrate": "8.0.4",
    "pg": "8.22.0",
    "tsx": "4.23.1"
  }
}
